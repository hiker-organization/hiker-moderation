# Para rodar LOCAL. No App Engine essas envs vem do env.yaml (veja env.example.yaml)
# Chave que a hiker-api manda no header X-API-Key
API_KEY=
# Sobrescreve o limiar salvo no modelo (0 a 1). Vazio = usa o do treino (0.9)
LIMIAR=
# So para o backfill.py
DATABASE_URL=
# Treino: 0 desliga as frases de review de dados/reviews_dominio.csv
USAR_DADOS_DOMINIO=1
